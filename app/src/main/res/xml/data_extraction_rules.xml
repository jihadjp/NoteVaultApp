<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="notevault_db-shm" />
        <exclude domain="database" path="notevault_db-wal" />
        <exclude domain="external" path="NoteVault/" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="notevault_db" />
    </device-transfer>
</data-extraction-rules>
